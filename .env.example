PORT=8787
DATA_DIR=./data
# Required: choose a strong unique password
ADMIN_PASSWORD=
# Optional: stable Plex OAuth client id (otherwise auto-generated in data/config/client.id)
# PLEX_CLIENT_ID=
# Optional: public URL for Plex webhooks, e.g. http://192.168.1.10:8787
# PUBLIC_URL=http://localhost:8787
# Optional: semicolon-separated roots for tools with fs.read (e.g. Preroll Scheduler).
# When set, bucket/media paths must stay under these directories. Unset = unrestricted (local dev).
# MEDIA_ROOTS=/prerolls
