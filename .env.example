# Required. Password for the toolkit's web page.
ADMIN_PASSWORD=

# Port the toolkit listens on. Open http://your-server:PORT
PORT=8787

# Your time zone, for recommendation schedules. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London

# Folder on this machine holding your preroll videos (Preroll Scheduler).
PREROLL_DIR=./prerolls

# Group that owns /var/run/docker.sock, so Home → Update can update the toolkit.
# Find it with: stat -c '%g' /var/run/docker.sock   (Docker Desktop: 0)
# Leave blank to update by hand instead.
DOCKER_GID=

# Optional. Address your Plex server can reach the toolkit on, e.g. http://192.168.1.20:8787
# Leave blank to use whatever address you open the toolkit with.
PUBLIC_URL=

# Optional. Secret token in the Plex webhook URL (/webhooks/plex/<token>).
# Leave blank to generate one in data/config/webhook.token. Changing it means updating the URL in Plex.
WEBHOOK_TOKEN=
